	"extends": ["./omomp-shared/biome.base.json"],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"extensions/**/*.ts",
			"omomp-shared/**/*.ts",
			"skills/**/*.js",
